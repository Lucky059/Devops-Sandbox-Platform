API_PORT=5000               # control API port
NGINX_PORT=80               # public nginx port
APP_PORT=3000               # demo app internal port
DEFAULT_TTL=1800            # 30 minutes default
CLEANUP_INTERVAL=60         # daemon checks every 60s
HEALTH_POLL_INTERVAL=30     # health check every 30s
HEALTH_FAILURE_THRESHOLD=3  # 3 fails = degraded