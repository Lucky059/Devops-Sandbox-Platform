# ── Platform Settings ───────────────────────────────
API_PORT=XXXX          # Port for the sandbox API
NGINX_PORT=XXXX        # Port for Nginx reverse proxy


# ── Demo App Settings ───────────────────────────────
DEMO_IMAGE=sandbox-demo-app:latest   # Demo app image tag
DEFAULT_TTL=1800                     # Default environment TTL in seconds

# ── Logging & Monitoring ────────────────────────────
CLEANUP_INTERVAL=XX    # How often cleanup daemon checks (seconds)
HEALTH_INTERVAL=XX     # How often poller checks health (seconds)


